{
  "permissions": {
    "deny": [
      "Bash(p4d*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/p4-guard.ps1"
          }
        ]
      }
    ]
  }
}
